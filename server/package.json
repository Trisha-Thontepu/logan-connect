{
  "name": "logan-connect-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "db:seed": "node src/db/seed.js",
    "db:geocode": "node src/db/geocode.js",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:geocode"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0",
    "zod": "^4.6.5"
  }
}
